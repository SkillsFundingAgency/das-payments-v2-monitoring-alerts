{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "functionAppName": {
      "type": "string"
    },
    "environmentName": {
      "type": "string",
      "metadata": {
        "description": "Short environment name, e.g. DAS, DST, SIT, ETE, MO, PP, PD. Applied as a resource tag."
      }
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Name of the existing storage account used for the Flex Consumption deployment container"
      }
    },
    "vnetName": {
      "type": "string",
      "defaultValue": "[concat('DCOL-', parameters('environmentName'), '-VNET-WEU')]",
      "metadata": {
        "description": "VNet holding the function app integration subnet. Defaults to the DCOL-<ENV>-VNET-WEU naming pattern; override for environments that don't follow it."
      }
    },
    "vnetResourceGroupName": {
      "type": "string",
      "defaultValue": "[parameters('vnetName')]",
      "metadata": {
        "description": "Resource group holding the VNet. Defaults to the VNet name, which is the pattern used by every environment so far."
      }
    },
    "functionAppSubnetName": {
      "type": "string",
      "defaultValue": "DCOL-FunctionApp-Integration-Subnet"
    },
    "deploymentContainerName": {
      "type": "string",
      "defaultValue": "monitoring-alerts-app-package",
      "metadata": {
        "description": "Blob container the Flex Consumption package is deployed to. Must already exist and must not be shared with another function app."
      }
    },
    "maximumInstanceCount": {
      "type": "int",
      "defaultValue": 100
    },
    "instanceMemoryMB": {
      "type": "int",
      "defaultValue": 2048,
      "allowedValues": [
        512,
        2048,
        4096
      ]
    },
    "appInsightsAuthHeader": {
      "type": "string",
      "defaultValue": "x-api-key",
      "metadata": {
        "description": "Header name the AppInsightsClient sends its API key in"
      }
    },
    "teamsBaseUrl": {
      "type": "string",
      "metadata": {
        "description": "Base address for the Teams HTTP client. Read at startup by Program.cs - the app cannot construct ITeamsClient without it."
      }
    },
    "azureWebJobsStorage": {
      "type": "securestring",
      "metadata": {
        "description": "Connection string for the storage account the Functions host uses for internal state and for the deployment container"
      }
    },
    "appInsightsAuthValue": {
      "type": "securestring",
      "metadata": {
        "description": "API key value sent by the AppInsightsClient in the appInsightsAuthHeader header"
      }
    },
    "teamsWebhookUrl": {
      "type": "securestring",
      "metadata": {
        "description": "Teams workflow webhook used by HttpTrigger1"
      }
    },
    "teamsWebhookUrl2": {
      "type": "securestring",
      "metadata": {
        "description": "Teams workflow webhook used by HttpTrigger2"
      }
    },
    "appInsightsInstrumentationKey": {
      "type": "securestring",
      "metadata": {
        "description": "Value for the APPINSIGHTS_INSTRUMENTATIONKEY setting read by the Functions host"
      }
    },
    "applicationInsightsConnectionString": {
      "type": "securestring",
      "metadata": {
        "description": "Connection string for the Application Insights resource. Required on Flex Consumption, which has no filesystem log streaming"
      }
    }
  },
  "variables": {
    "functionAppApiVersion": "2023-12-01",
    "deploymentStorageContainerUri": "[concat('https://', parameters('storageAccountName'), '.blob.core.windows.net/', parameters('deploymentContainerName'))]",
    "functionAppSubnetId": "[resourceId(parameters('vnetResourceGroupName'), 'Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), parameters('functionAppSubnetName'))]",
    "appSettings": [
      {
        "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
        "value": "[parameters('appInsightsInstrumentationKey')]"
      },
      {
        "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
        "value": "[parameters('applicationInsightsConnectionString')]"
      },
      {
        "name": "AppInsightsAuthHeader",
        "value": "[parameters('appInsightsAuthHeader')]"
      },
      {
        "name": "AppInsightsAuthValue",
        "value": "[parameters('appInsightsAuthValue')]"
      },
      {
        "name": "AzureWebJobsStorage",
        "value": "[parameters('azureWebJobsStorage')]"
      },
      {
        "name": "DEPLOYMENT_STORAGE_CONNECTION_STRING",
        "value": "[parameters('azureWebJobsStorage')]"
      },
      {
        "name": "TeamsBaseUrl",
        "value": "[parameters('teamsBaseUrl')]"
      },
      {
        "name": "TeamsWebhookURL",
        "value": "[parameters('teamsWebhookUrl')]"
      },
      {
        "name": "TeamsWebhookURL2",
        "value": "[parameters('teamsWebhookUrl2')]"
      }
    ]
  },
  "resources": [
    {
      "name": "[parameters('functionAppName')]",
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "location": "[resourceGroup().location]",
      "tags": {
        "Environment": "[parameters('environmentName')]"
      },
      "sku": {
        "name": "FC1",
        "tier": "FlexConsumption"
      },
      "kind": "functionapp",
      "properties": {
        "reserved": true
      }
    },
    {
      "name": "[parameters('functionAppName')]",
      "type": "Microsoft.Web/sites",
      "kind": "functionapp,linux",
      "apiVersion": "[variables('functionAppApiVersion')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "Environment": "[parameters('environmentName')]"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('functionAppName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('functionAppName'))]",
        "virtualNetworkSubnetId": "[variables('functionAppSubnetId')]",
        "clientAffinityEnabled": false,
        "httpsOnly": true,
        "siteConfig": {
          "appSettings": "[variables('appSettings')]",
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled"
        },
        "functionAppConfig": {
          "deployment": {
            "storage": {
              "type": "blobContainer",
              "value": "[variables('deploymentStorageContainerUri')]",
              "authentication": {
                "type": "StorageAccountConnectionString",
                "storageAccountConnectionStringName": "DEPLOYMENT_STORAGE_CONNECTION_STRING"
              }
            }
          },
          "scaleAndConcurrency": {
            "maximumInstanceCount": "[parameters('maximumInstanceCount')]",
            "instanceMemoryMB": "[parameters('instanceMemoryMB')]"
          },
          "runtime": {
            "name": "dotnet-isolated",
            "version": "8.0"
          }
        }
      }
    }
  ],
  "outputs": {
    "managedServiceIdentityId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), variables('functionAppApiVersion'), 'Full').identity.principalId]"
    }
  }
}
